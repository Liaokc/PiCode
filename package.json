{
  "name": "picode",
  "private": true,
  "version": "1.0.0-alpha.1",
  "description": "PiCode — a ZCode-shaped desktop shell around the Pi agent brain",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke:host": "npm run build && node scripts/smoke/host-contract-smoke.mjs",
    "smoke:electron": "npm run build && PICODE_SMOKE=1 electron ."
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11"
  }
}
