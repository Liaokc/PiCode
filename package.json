{
  "name": "picode",
  "private": true,
  "version": "1.0.0-alpha.1",
  "description": "PiCode — a ZCode-shaped desktop shell around the Pi agent brain",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "lint": "eslint .",
    "test": "vitest run",
    "usage:scan": "node scripts/usage-scan.ts",
    "smoke:host": "npm run build && node scripts/smoke/host-contract-smoke.mjs",
    "smoke:pty": "ELECTRON_RUN_AS_NODE=1 electron scripts/smoke/pty-smoke.mjs",
    "smoke:usage": "node scripts/smoke/usage-smoke.ts",
    "smoke:interop": "npm run build && node scripts/smoke/interop-smoke.ts",
    "smoke:electron": "npm run build && node scripts/smoke/electron-smoke.mjs",
    "smoke": "bash scripts/smoke/run-all.sh",
    "package": "node scripts/package.mjs",
    "package:verify": "node scripts/package.mjs --verify",
    "visual:transcript": "npm run build && PICODE_VISUAL=1 electron .",
    "visual:settings": "npm run build && PICODE_VISUAL_SETTINGS=1 PICODE_FAKE_SETTINGS=1 electron .",
    "visual:usage": "npm run build && PICODE_VISUAL_USAGE=1 PICODE_FAKE_USAGE=1 electron ."
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11"
  }
}
